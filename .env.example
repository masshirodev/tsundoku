# The shared token that unlocks the app. `yarn run serve` makes one into
# TSUNDOKU_HOME/.env when none is set; in `yarn run dev` an unset token means
# no authentication at all.
#   echo "TSUNDOKU_TOKEN=$(node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))")" >> .env
TSUNDOKU_TOKEN=

# Where the library database lives. Defaults to data/tsundoku.sqlite.
# DATABASE_PATH=

# The data folder (doc/DISTRIBUTION.md, "One data directory"). Every folder
# below defaults to one inside it. Unset: %LOCALAPPDATA%\tsundoku on Windows,
# ~/Library/Application Support/tsundoku on macOS, $XDG_DATA_HOME/tsundoku
# (~/.local/share/tsundoku) on Linux. The workstation's is /mnt/hdd2/tsundoku.
# TSUNDOKU_HOME=
# LIBRARY_ROOT=        # TSUNDOKU_HOME/library: the folder the scanner walks
# COVER_DIR=           # TSUNDOKU_HOME/covers
# TRASH_DIR=           # TSUNDOKU_HOME/trash
# BACKUP_DIR=          # TSUNDOKU_HOME/backups; /mnt/backup/tsundoku here
# ENGINE_STORE=        # TSUNDOKU_HOME/engine/store
# OCR_SCRATCH=         # TSUNDOKU_HOME/ocr-scratch
# MOKURO_BIN=          # TSUNDOKU_HOME/mokuro/venv/bin/mokuro

# TSUNDOKU_SERVE=local serves http://localhost on this computer only, with no
# Tailscale: a friend's install (doc/SERVING.md, "Local").
# serve.ts serves over HTTPS by default: the app on 127.0.0.1:PORT, and
# `tailscale serve` terminating TLS on TSUNDOKU_HTTPS_PORT (443, 8443 or
# 10000). doc/SERVING.md.
# TSUNDOKU_SERVE=https
# TSUNDOKU_HTTPS_PORT=8443
# PORT=42143

# TSUNDOKU_SERVE=http binds the tailnet address on plain http instead. HOST
# names another address; a wildcard is refused unless TSUNDOKU_BIND_ANY=1.
# HOST=
# TSUNDOKU_BIND_ANY=

# Novels to Ranobe (doc/RANOBE.md): a personal token from ranobe.ink's
# Settings > Connected apps, with Read catalogue, Write library and Suggest
# entries. Unset, nothing is sent. RANOBE_URL points it at another server.
# RANOBE_TOKEN=
# RANOBE_URL=http://localhost:42145/api/v1

# Suggestions to Ranobe go through its app account, whose edits wait for the
# owner (doc/RANOBE.md, "Suggesting a novel"). catalogue:read,catalogue:write
# only. Unset, no novel is suggested.
# RANOBE_SUGGEST_TOKEN=


# The extension engine and FlareSolverr (doc/EXTENSION-ENGINE.md, ops/engine/).
# ENGINE_TOKEN is the engine's bearer token: required by the compose file,
# and sent by tsundoku on every call.
#   echo "ENGINE_TOKEN=$(openssl rand -base64 24 | tr '+/' '-_' | tr -d '=')" >> .env
# ENGINE_URL=http://127.0.0.1:4590
# ENGINE_TOKEN=

# Where the app itself reaches FlareSolverr, for a novel plugin whose site has a
# browser check (doc/NOVELS.md, "Past a site's bot check"). It is not
# ENGINE_SOLVER_URL: in a release the launcher puts the solver on 127.0.0.1 for
# both, but in development the engine's is a name only its compose network
# resolves. ops/engine/compose.yml publishes the development one on
# 127.0.0.1:8193 (never 8191, the live release's own solver), and a development
# .env sets this to it.
# NOVEL_SOLVER_URL=http://127.0.0.1:8193/v1
