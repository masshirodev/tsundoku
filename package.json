{
	"name": "tsundoku",
	"private": true,
	"version": "0.0.1",
	"license": "PolyForm-Noncommercial-1.0.0",
	"type": "module",
	"packageManager": "yarn@1.22.22",
	"scripts": {
		"dev": "vite dev --port 42143",
		"build": "vite build",
		"preview": "vite preview --port 42143",
		"prepare": "svelte-kit sync || echo ''; husky || true; node node_modules/kotoba/scripts/sync-dict.js static/dict || true",
		"hooks:check": "node scripts/hooks-armed.mjs",
		"check": "node scripts/hooks-armed.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint-staged": "lint-staged",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"test:all": "yarn run test && yarn run test:e2e",
		"serve": "node --experimental-strip-types scripts/serve.ts",
		"seed": "node --experimental-strip-types scripts/seed.ts",
		"import": "node --experimental-strip-types scripts/import.ts",
		"backup": "node --experimental-strip-types scripts/backup.ts",
		"covers": "node --experimental-strip-types scripts/covers.ts",
		"sync-import": "node --experimental-strip-types scripts/sync-import.ts",
		"sync-setup": "node --experimental-strip-types scripts/sync-setup.ts",
		"ocr": "node --experimental-strip-types scripts/ocr.ts",
		"dupes": "node --experimental-strip-types scripts/dupes.ts",
		"links": "node --experimental-strip-types scripts/links.ts",
		"ranobe": "node --experimental-strip-types scripts/ranobe.ts",
		"release": "node --experimental-strip-types ops/release/release.ts",
		"secrets:pull": "sh scripts/secrets-pull.sh"
	},
	"dependencies": {
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-sans-jp": "^5.3.0",
		"@fontsource/ibm-plex-sans-kr": "^5.3.0",
		"@fontsource/ibm-plex-serif": "^5.3.0",
		"@ibm/plex-mono": "^2.5.0",
		"@noble/ciphers": "^2.1.1",
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.0.2",
		"@sveltejs/adapter-node": "^5.5.7",
		"better-sqlite3": "^12.11.1",
		"cheerio": "^1.0.0",
		"dayjs": "^1.11.13",
		"hls.js": "1.7.3",
		"htmlparser2": "^9.1.0",
		"kotoba": "link:../kotoba",
		"protobufjs": "^7.4.0",
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24",
		"@vitest/coverage-v8": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"node-addon-api": "^8.9.2",
		"node-gyp": "^13.0.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
