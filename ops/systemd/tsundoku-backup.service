# The nightly database snapshot (doc/BACKUPS.md). A user unit: install with
#   ln -s ~/projects/tsundoku/ops/systemd/tsundoku-backup.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now tsundoku-backup.timer
[Unit]
Description=tsundoku: snapshot the library database
RequiresMountsFor=/mnt/backup

[Service]
Type=oneshot
WorkingDirectory=%h/projects/tsundoku
# mise's shim, so the unit gets the project's Node without a login shell.
ExecStart=%h/.local/share/mise/shims/node --experimental-strip-types scripts/backup.ts
Nice=10
IOSchedulingClass=idle
