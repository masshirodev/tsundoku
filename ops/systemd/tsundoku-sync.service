# Import what Syncthing brought from the tablet (doc/SYNC.md). A user unit: install with
#   ln -s ~/projects/tsundoku-jobs/ops/systemd/tsundoku-sync.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now tsundoku-sync.timer
[Unit]
Description=tsundoku: import what the tablet synced
RequiresMountsFor=/mnt/hdd2
Wants=syncthing.service
After=syncthing.service

[Service]
Type=oneshot
# The checkout at the installed release's tag (ops/workstation/install-release.sh,
# card c228), never ~/projects/tsundoku, where work in progress lives.
WorkingDirectory=%h/projects/tsundoku-jobs
# The live settings: the data folder's .env, which the bundle's launcher
# reads too (doc/SECRETS.md). The jobs checkout has no .env of its own.
EnvironmentFile=/mnt/hdd2/tsundoku/.env
# The workstation's data folders (doc/DISTRIBUTION.md, "One data directory").
# The code's defaults are per-OS app-data folders now; .env says the same
# for scripts run by hand, and these keep the units right even without it.
Environment=TSUNDOKU_HOME=/mnt/hdd2/tsundoku
Environment=BACKUP_DIR=/mnt/backup/tsundoku
# Runs scripts/ from a checkout: never let it migrate the live database
# (doc/SERVING.md, "Who migrates").
Environment=TSUNDOKU_MIGRATE=off
# mise's shim, so the unit gets the project's Node without a login shell.
ExecStart=%h/.local/share/mise/shims/node --experimental-strip-types scripts/sync-import.ts
Nice=10
