# The extension engine and FlareSolverr (doc/EXTENSION-ENGINE.md). A user unit:
# install with
#   ln -s ~/projects/tsundoku/ops/systemd/tsundoku-engine.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now tsundoku-engine.service
[Unit]
Description=tsundoku: the extension engine and FlareSolverr
RequiresMountsFor=/mnt/hdd2
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/projects/tsundoku
# ENGINE_TOKEN for the compose file.
EnvironmentFile=%h/projects/tsundoku/.env
# Made by us before Docker makes the mount point as root, which would leave
# the engine (uid 1000) unable to write its APKs.
ExecStartPre=/usr/bin/mkdir -p /mnt/hdd2/tsundoku/engine/apks
ExecStart=/usr/bin/docker compose -f ops/engine/compose.yml up --abort-on-container-exit
ExecStop=/usr/bin/docker compose -f ops/engine/compose.yml down
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
