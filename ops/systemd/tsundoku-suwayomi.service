# Suwayomi-Server, downloading into the library (doc/DOWNLOADING.md). A user unit:
# install with
#   ln -s ~/projects/tsundoku/ops/systemd/tsundoku-suwayomi.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now tsundoku-suwayomi.service
[Unit]
Description=tsundoku: Suwayomi-Server, downloading into the library
RequiresMountsFor=/mnt/hdd2
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/projects/tsundoku
# LIBRARY_ROOT for the compose file's mounts. Nothing else in it reaches the container.
EnvironmentFile=%h/projects/tsundoku/.env
# Bind-mount targets inside the data folder, made by us before Docker makes
# them as root, which would leave Suwayomi (uid 1000) unable to write beside them.
ExecStartPre=/usr/bin/mkdir -p ${LIBRARY_ROOT}/devices/suwayomi/Mihon/downloads ${LIBRARY_ROOT}/devices/suwayomi/Mihon/autobackup /mnt/hdd2/tsundoku/suwayomi/downloads/mangas /mnt/hdd2/tsundoku/suwayomi/backups
ExecStart=/usr/bin/docker compose -f ops/suwayomi/compose.yml up --abort-on-container-exit
ExecStop=/usr/bin/docker compose -f ops/suwayomi/compose.yml down
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
