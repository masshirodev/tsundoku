node_modules/
.svelte-kit/
/build/
/coverage/
/test-results/
/playwright-report/
.env
.env.*
!.env.example
# Infisical's machine identity for secrets-pull (doc/SECRETS.md): never tracked.
.infisical-identity
/data/
samples/
/temp/
.husky/_

# Handoff bundles as downloaded; their contents are mirrored in doc/design/handoff/.
