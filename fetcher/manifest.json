{
	"manifest_version": 3,
	"name": "tsundoku fetcher",
	"version": "0.1.0",
	"description": "Makes network requests for the tsundoku web app, with the browser's own cookies. Answers tsundoku's own pages only.",
	"minimum_chrome_version": "121",
	"background": {
		"service_worker": "background.js",
		"scripts": ["background.js"]
	},
	"host_permissions": ["<all_urls>"],
	"permissions": ["declarativeNetRequestWithHostAccess", "cookies", "webRequest", "storage"],
	"content_scripts": [
		{
			"js": ["content.js"],
			"run_at": "document_start"
		}
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "fetcher@tsundoku.lt",
			"strict_min_version": "140.0",
			"data_collection_permissions": { "required": ["none"] }
		},
		"gecko_android": {
			"strict_min_version": "142.0"
		}
	}
}
